{{/* NFX-A04/H-C: a declared shared owner is presented by its one retained
panel instance in the panels home. When that linked panel is rendered,
the page slot emits no competing mount; otherwise the page mounts here. */}}
{{$ownerPresented := .ExtensionOwnerPresented}}
<section class="extension-page{{if $ownerPresented}} extension-page-owner-presented{{end}}" {{if $ownerPresented}}aria-label="{{.Extension.Title}}"{{else}}aria-labelledby="extension-page-title"{{end}}>
	{{if not $ownerPresented}}<h1 id="extension-page-title" class="ui dividing header">{{.Extension.Title}}</h1>{{end}}
	{{if not $ownerPresented}}{{template "extensions/mount" .ExtensionMount}}{{end}}
</section>

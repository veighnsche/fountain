{{if .ExtensionPanelsHome}}
<aside id="extension-panels" class="extension-workspace-panels" aria-label="Extension panels" data-extension-panels data-app-sub-url="{{AppSubUrl}}"{{if .ExtensionDirectPatterns}} data-extension-subroutes="{{.ExtensionDirectPatterns}}"{{end}}{{if .ExtensionRepositoryID}} data-extension-repository-id="{{.ExtensionRepositoryID}}"{{end}} data-extension-session-generation="{{.ExtensionSessionGeneration}}"{{if not .PageIsWorkspacePage}} hidden inert{{end}}>
	{{range .ExtensionPanels}}
	<section class="extension-workspace-panel" aria-labelledby="extension-panel-{{.ExtensionID}}-{{.ID}}">
		<h2 id="extension-panel-{{.ExtensionID}}-{{.ID}}">{{.Title}}</h2>
		<div data-extension-panel data-extension-contract-version="{{$.BrowserContractVersion}}" data-app-sub-url="{{AppSubUrl}}" data-extension-id="{{.ExtensionID}}" data-extension-panel-id="{{.ID}}"{{if .OwnerID}} data-extension-owner-id="{{.OwnerID}}"{{end}} data-extension-entry="{{.Entry}}" data-extension-api-base="{{.APIBase}}" data-extension-asset-base="{{.AssetBase}}" data-extension-session-generation="{{$.ExtensionSessionGeneration}}"{{if $.ExtensionRepositoryID}} data-extension-repository-id="{{$.ExtensionRepositoryID}}"{{end}}></div>
	</section>
	{{end}}
</aside>
{{end}}
